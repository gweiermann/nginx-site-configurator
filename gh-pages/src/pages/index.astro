---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CLIExamples from '../components/CLIExamples.astro';
---

<Base title="nginx-cli • One-file Nginx manager" description="Single-file Nginx vhost manager with a powerful CLI">
	<Hero oneliner="Installs to ~/.local/bin and enables context-aware tab completion." />

	<section id="get-started" class="relative mx-auto w-full max-w-6xl px-6 py-8">
		<div class="prose max-w-none">
			<h2>Getting started</h2>
			<p>
				Install the standalone binary and enable shell completions. No Python environment needed afterwards.
			</p>
		</div>

		<div class="mt-4 rounded-2xl bg-slate-900/60 p-4 shadow-soft ring-1 ring-white/10">
			<h3 class="text-sm font-semibold text-white/90">One-liner install</h3>
			<pre class="mt-2 overflow-x-auto"><code class="language-bash">wget -O nginx-cli https://github.com/gweiermann/nginx-site-configurator/releases/latest/download/nginx-cli && chmod +x nginx-cli && ./nginx-cli --install</code></pre>
			<ul class="mt-3 list-disc space-y-1 pl-6 text-sm text-slate-300">
				<li>Copies to <code>~/.local/bin/nginx-cli</code> and makes it executable.</li>
				<li>Adds an alias and argcomplete block to your <code>~/.bashrc</code> if present.</li>
				<li>Attempts to install <code>argcomplete</code> for tab completion (warns if it fails).</li>
			</ul>
			<p class="mt-3 text-sm text-slate-400">Open a new shell or run <code>source ~/.bashrc</code> to activate.</p>
		</div>

		<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
			<div class="rounded-2xl bg-slate-900/60 p-4 shadow-soft ring-1 ring-white/10">
				<h3 class="text-sm font-semibold text-white/90">Uninstall</h3>
				<pre class="mt-2 overflow-x-auto"><code class="language-bash">nginx-cli --uninstall</code></pre>
				<p class="mt-2 text-sm text-slate-300">Removes alias/completion blocks, deletes the binary, and cleans up.</p>
			</div>
			<div class="rounded-2xl bg-slate-900/60 p-4 shadow-soft ring-1 ring-white/10">
				<h3 class="text-sm font-semibold text-white/90">Autocomplete tips</h3>
				<ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-slate-300">
					<li>Options and subcommands are suggested as you type.</li>
					<li>Host arguments are populated from your current <code>sites.json</code>.</li>
					<li>If completion stops working, run <code>python3 -m pip install --user argcomplete</code> and <code>source ~/.bashrc</code>.</li>
				</ul>
			</div>
		</div>
	</section>

	<CLIExamples />

	<footer class="mx-auto w-full max-w-6xl px-6 pb-16 pt-8 text-sm text-slate-400">
		<div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
			<p>MIT • nginx-site-configurator</p>
			<a class="rounded-md bg-white/5 px-3 py-2 ring-1 ring-inset ring-white/10 hover:bg-white/10" href="https://github.com/gweiermann/nginx-site-configurator" target="_blank" rel="noreferrer">
				GitHub
			</a>
		</div>
	</footer>
</Base>

