#!/usr/bin/env python3

"""
nginx-cli

Provides a small command line parser for managing site configuration.

Supported commands (implemented as argparse stubs):
 - ls
 - add docker <sub.domain.tld> <Port>
 - add redirect <sub.domain.tld> <other.domain.tld>
 - add reverse-proxy <sub.domain.tld> <https://example.com>
 - setup-ssl [--for DOMAIN]...  (repeat --for to specify multiple domains)
 - remove <sub.domain.tld>
 - disable <sub.domain.tld>
 - enable <sub.domain.tld>

This file only implements argument parsing and dispatch stubs. Business logic
should be added to the corresponding functions below.
"""


import sys
from os import path
from config import Configuration
import actions
from arguments import parse_args

CONFIG_BASENAME = "sites.json"

def get_config_filename():
    script_directory = path.dirname(path.realpath(__file__))
    return path.join(script_directory, CONFIG_BASENAME)


def main(args, configuration) -> int:
    if args.command == 'ls':
        actions.ls(configuration)
        return 0

    if args.command == 'add':
        if args.add_type == 'docker':
            actions.add_docker(configuration, args.subdomain, args.port)
            return 0
        if args.add_type == 'redirect':
            actions.add_redirect(configuration, args.source, args.target)
            return 0
        if args.add_type == 'reverse-proxy':
            actions.add_reverse_proxy(configuration, args.subdomain, args.upstream)
            return 0

    if args.command == 'setup-ssl':
        actions.setup_ssl(configuration, args.domains, getattr(args, 'wildcard', False))
        return 0

    if args.command == 'remove':
        actions.remove_site(configuration, args.subdomain)
        return 0

    if args.command == 'disable':
        actions.disable_site(configuration, args.subdomain)
        return 0

    if args.command == 'enable':
        actions.enable_site(configuration, args.subdomain)
        return 0

    if args.command == 'apply':
        actions.apply(configuration)
        return 0

    parser.print_help()
    return 2


if __name__ == '__main__':
    try:    
        args = parse_args()
        configuration = Configuration.load(get_config_filename())
        configuration.fill_missing_ssl_entries()
        raise SystemExit(main(args, configuration))
    except SystemExit as e:
        raise e
    except Exception as e:
        raise e
        print(str(e))
